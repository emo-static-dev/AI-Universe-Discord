{
  "name": "ai-universe-discord",
  "version": "1.0.0",
  "description": "The world's biggest AI-focused Discord community with advanced automation, moderation, and AI features",
  "main": "dist/index.js",
  "type": "module",
  "scripts": {
    "dev": "tsx watch src/index.ts",
    "build": "tsc",
    "start": "node dist/index.js",
    "prisma:generate": "prisma generate",
    "prisma:migrate": "prisma migrate dev",
    "prisma:push": "prisma db push",
    "lint": "eslint src --ext .ts",
    "format": "prettier --write \"src/**/*.ts\""
  },
  "keywords": ["discord", "discord-bot", "discord-js", "typescript", "ai", "automation", "community"],
  "author": "AI Universe",
  "license": "MIT",
  "dependencies": {
    "discord.js": "^14.14.0",
    "@prisma/client": "^5.7.0",
    "redis": "^4.6.11",
    "dotenv": "^16.3.1",
    "axios": "^1.6.2",
    "winston": "^3.11.0",
    "express": "^4.18.2",
    "cors": "^2.8.5",
    "jsonwebtoken": "^9.1.2"
  },
  "devDependencies": {
    "@types/node": "^20.10.0",
    "typescript": "^5.3.3",
    "tsx": "^4.7.0",
    "prisma": "^5.7.0",
    "@typescript-eslint/eslint-plugin": "^6.13.2",
    "@typescript-eslint/parser": "^6.13.2",
    "eslint": "^8.55.0",
    "prettier": "^3.1.1"
  }
}
